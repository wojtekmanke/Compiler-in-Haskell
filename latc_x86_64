#!/usr/bin/env bash
#
# Compiles a Latte program to an x86-64 Linux executable.
#
#   latc_x86_64 path/to/program.lat
#
# writes the assembly to path/to/program.s and the executable to
# path/to/program. The first line printed to the standard error is "OK" on
# success and "ERROR" otherwise, in which case the exit status is 1.
#
# The assembly is assembled and linked by the C compiler, cc, or by $CC if
# that is set, for example to a cross-compiler such as x86_64-linux-gnu-gcc.

set -u

# The compiler and the runtime library live next to this script, even when it
# is run through a symbolic link.
script=$(readlink -f "${BASH_SOURCE[0]}" 2> /dev/null) || script=${BASH_SOURCE[0]}
root=$(cd "$(dirname "$script")" && pwd)
compiler=$root/latc
runtime=$root/runtime/runtime.o

fail() {
    printf 'ERROR\n%s\n' "$1" >&2
    exit 1
}

[[ $# -eq 1 ]] || fail "usage: $(basename "$0") FILE.lat"
[[ $1 == *.lat ]] || fail "$1: the name of a Latte source file must end in .lat"
[[ -x $compiler && -f $runtime ]] || fail "the compiler is not built; run 'make' in $root"

# A name that starts with a dash would be taken for an option.
source=$1
[[ $source == -* ]] && source=./$source
output=${source%.lat}

diagnostics=$("$compiler" "$source" -o "$output.s" 2>&1) || fail "$diagnostics"
diagnostics=$("${CC:-cc}" -o "$output" "$output.s" "$runtime" 2>&1) || fail "$diagnostics"

echo OK >&2
