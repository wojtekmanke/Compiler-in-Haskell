-- Grammar of Latte (core language + arrays + structs), in LBNF.
--
-- The lexer, parser and abstract syntax in src/Latte/{Lex.x,Par.y,Abs.hs} are
-- generated from this file by BNFC; run `make grammar` after changing it.
--
-- The generated LALR(1) parser has two shift/reduce conflicts. Both are benign
-- and resolved in favour of shifting, which is the intended reading:
--   * the dangling `else`, which binds to the nearest `if`;
--   * `new T [`, which starts an array allocation rather than indexing `new T`.

-- programs ------------------------------------------------

entrypoints Program ;

Program.   Program ::= [TopDef] ;

FnDef.     TopDef ::= Type Ident "(" [Arg] ")" Block ;

ClDef.     TopDef ::= "class" Ident "{" [ClassEl] "}" ;

separator nonempty TopDef "" ;

ClElem.    ClassEl ::= Type Ident ;

terminator ClassEl ";" ;

Arg.       Arg ::= Type Ident ;

separator  Arg "," ;

-- statements ----------------------------------------------

Block.     Block ::= "{" [Stmt] "}" ;

separator  Stmt "" ;

Empty.     Stmt ::= ";" ;

BStmt.     Stmt ::= Block ;

Decl.      Stmt ::= Type [Item] ";" ;

NoInit.    Item ::= Ident ;

Init.      Item ::= Ident "=" Expr ;

separator nonempty Item "," ;

Ass.       Stmt ::= Expr7 "=" Expr  ";" ;

Incr.      Stmt ::= Expr7 "++"  ";" ;

Decr.      Stmt ::= Expr7 "--"  ";" ;

Ret.       Stmt ::= "return" Expr ";" ;

VRet.      Stmt ::= "return" ";" ;

Cond.      Stmt ::= "if" "(" Expr ")" Stmt  ;

CondElse.  Stmt ::= "if" "(" Expr ")" Stmt "else" Stmt  ;

While.     Stmt ::= "while" "(" Expr ")" Stmt ;

For.       Stmt ::= "for" "(" Type Ident ":" Expr7 ")" Stmt ;

SExp.      Stmt ::= Expr  ";" ;

-- Types ---------------------------------------------------

Int.       Type ::= "int" ;

Str.       Type ::= "string" ;

Bool.      Type ::= "boolean" ;

Void.      Type ::= "void" ;

ClassT.    Type ::= Ident ;

Array.     Type ::= Type "[]" ;

-- Expressions ---------------------------------------------

ENew.      Expr8 ::= "new" Type ;

ENewArray. Expr7 ::= "new" Type "[" Expr "]" ;

EVar.      Expr7 ::= Ident ;

EApp.      Expr7 ::= Ident "(" [Expr] ")" ;

EField.    Expr7 ::= Expr7 "." Ident ;

EArrayItem. Expr7 ::= Expr7 "[" Expr "]" ;

-- A null reference is written as a cast, `(C)null`. The cast is parsed as a
-- parenthesised expression because `"(" Ident ")"` would make every
-- parenthesised variable, such as `(x) + 1`, a syntax error in an LALR(1)
-- parser; the type checker verifies that the expression is a class name.
ENull.     Expr6 ::= "(" Expr ")" "null" ;

ELitInt.   Expr6 ::= Integer ;

ELitTrue.  Expr6 ::= "true" ;

ELitFalse. Expr6 ::= "false" ;

EString.   Expr6 ::= String ;

Neg.       Expr5 ::= "-" Expr6 ;

Not.       Expr5 ::= "!" Expr6 ;

EMul.      Expr4 ::= Expr4 MulOp Expr5 ;

EAdd.      Expr3 ::= Expr3 AddOp Expr4 ;

ERel.      Expr2 ::= Expr2 RelOp Expr3 ;

EAnd.      Expr1 ::= Expr2 "&&" Expr1 ;

EOr.       Expr ::= Expr1 "||" Expr ;

coercions  Expr 8 ;

separator  Expr "," ;

-- operators -----------------------------------------------

Plus.      AddOp ::= "+" ;

Minus.     AddOp ::= "-" ;

Times.     MulOp ::= "*" ;

Div.       MulOp ::= "/" ;

Mod.       MulOp ::= "%" ;

LTH.       RelOp ::= "<" ;

LE.        RelOp ::= "<=" ;

GTH.       RelOp ::= ">" ;

GE.        RelOp ::= ">=" ;

EQU.       RelOp ::= "==" ;

NE.        RelOp ::= "!=" ;

-- comments ------------------------------------------------

comment    "#" ;

comment    "//" ;

comment    "/*" "*/" ;
